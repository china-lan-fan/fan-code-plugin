{
  "scopeName": "source.fan",
  "name": "fan",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#model-definition" },
    { "include": "#function-definition" },
    { "include": "#keywords-control" },
    { "include": "#keywords-declaration" },
    { "include": "#keywords-operator" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#member-access" },
    { "include": "#function-call" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.fan",
          "match": "#.*$"
        },
        {
          "name": "comment.line.fan",
          "match": "(?<![\\p{L}\\p{N}_])注释(?=$|[\\s:：])[^\\n]*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.fan",
          "begin": "\"",
          "end": "\"|(?=\\n)",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.fan" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.fan" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.fan",
              "match": "\\\\(?:[\"\\\\nrt]|u\\h{4})"
            },
            {
              "name": "invalid.illegal.unknown-escape.fan",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.fan",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.fan",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords-control": {
      "patterns": [
        {
          "name": "keyword.control.fan",
          "match": "(?<![\\p{L}\\p{N}_])(如果|判断|那么|否则如果|否则|其他|结束|当|循环|重复|直到|次|遍历|中的|跳出|继续|尝试|捕获|检查|导入|导出|返回)(?![\\p{L}\\p{N}_])"
        }
      ]
    },
    "keywords-declaration": {
      "patterns": [
        {
          "name": "keyword.declaration.fan",
          "match": "(?<![\\p{L}\\p{N}_])(定义|变量|常量|函数|嵌入)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.declaration.method.fan",
          "match": "(?<![\\p{L}\\p{N}_])(方法)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "variable.language.self.fan",
          "match": "(?<![\\p{L}\\p{N}_])(自己)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.other.model.fan",
          "match": "(?<![\\p{L}\\p{N}_])(模型|类)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.other.member.fan",
          "match": "(?<![\\p{L}\\p{N}_])(的|为)(?![\\p{L}\\p{N}_])"
        }
      ]
    },
    "keywords-operator": {
      "patterns": [
        {
          "name": "keyword.operator.word.fan",
          "match": "(?<![\\p{L}\\p{N}_])(加|减|乘|除|取余|等于|不等于|小于等于|大于等于|小于|大于|加等于|减等于|乘等于|除等于|自增|自减|且|或|非)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.operator.symbol.fan",
          "match": "->|→|\\+=|-=|\\*=|/=|\\+\\+|--|==|!=|<=|>=|&&|\\|\\||[-+*/%=<>!]"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.fan",
          "match": "(?<![\\p{L}\\p{N}_])(整数|小数|字符串|布尔|数组|字典|错误)(?![\\p{L}\\p{N}_])"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.fan",
          "match": "(?<![\\p{L}\\p{N}_])(真|假|空)(?![\\p{L}\\p{N}_])"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.fan",
          "match": "(?<![\\p{L}\\p{N}_])(长度|追加|打印|错误)(?=\\s*[(（])"
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{N}_])(?:定义\\s+)?([\\p{L}_][\\p{L}\\p{N}_]*)\\s+的\\s+方法\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": { "name": "entity.name.type.fan" },
            "2": { "name": "entity.name.function.fan" }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(?:定义\\s+)?函数\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": { "name": "entity.name.function.fan" }
          }
        }
      ]
    },
    "model-definition": {
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{N}_])定义\\s+(模型|类)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": { "name": "keyword.other.model.fan" },
            "2": { "name": "entity.name.type.fan" }
          }
        }
      ]
    },
    "member-access": {
      "patterns": [
        {
          "match": "(?:\\.)\\s*([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": { "name": "variable.other.member.fan" }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "([\\p{L}_][\\p{L}\\p{N}_]*)(?=\\s*[(（])",
          "captures": {
            "1": { "name": "entity.name.function.call.fan" }
          }
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.delimiter.fan",
          "match": "[、,，]"
        },
        {
          "name": "punctuation.separator.annotation.fan",
          "match": "[:：]"
        },
        {
          "name": "punctuation.section.parens.begin.fan",
          "match": "[(（]"
        },
        {
          "name": "punctuation.section.parens.end.fan",
          "match": "[)）]"
        },
        {
          "name": "punctuation.section.brackets.begin.fan",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.fan",
          "match": "\\]"
        },
        {
          "name": "punctuation.section.braces.begin.fan",
          "match": "{"
        },
        {
          "name": "punctuation.section.braces.end.fan",
          "match": "}"
        }
      ]
    }
  }
}
