{
  "如果条件": {
    "prefix": "如果",
    "body": [
      "如果 ${1:条件} 那么",
      "    $0",
      "结束"
    ],
    "description": "如果…那么…结束 条件语句"
  },
  "如果否则": {
    "prefix": "否则",
    "body": [
      "否则",
      "    $0"
    ],
    "description": "否则 分支"
  },
  "否则如果": {
    "prefix": "否则如果",
    "body": [
      "否则如果 ${1:条件} 那么",
      "    $0"
    ],
    "description": "否则如果…那么 分支"
  },
  "当循环": {
    "prefix": "当",
    "body": [
      "当 ${1:条件} 循环",
      "    $0",
      "结束"
    ],
    "description": "当…循环 条件循环"
  },
  "遍历": {
    "prefix": "遍历",
    "body": [
      "遍历 ${1:容器} 中的 ${2:元素}",
      "    $0",
      "结束"
    ],
    "description": "遍历…中的 for-in 循环"
  },
  "重复次数": {
    "prefix": "重复",
    "body": [
      "重复 ${1:次数} 次",
      "    $0",
      "结束"
    ],
    "description": "重复 n 次循环"
  },
  "无限循环": {
    "prefix": "循环",
    "body": [
      "循环",
      "    $0",
      "结束"
    ],
    "description": "无限循环（配合 跳出 使用）"
  },
  "定义函数": {
    "prefix": "函数",
    "body": [
      "定义 函数 ${1:函数名}(${2:参数})${3: -> ${4:返回类型}}",
      "    $0",
      "结束"
    ],
    "description": "定义函数"
  },
  "定义模型": {
    "prefix": "模型",
    "body": [
      "定义 模型 ${1:模型名}",
      "    $0",
      "结束"
    ],
    "description": "定义模型"
  },
  "定义类": {
    "prefix": "类",
    "body": [
      "定义 类 ${1:类名}",
      "    $0",
      "结束"
    ],
    "description": "定义类（模型的别名）"
  },
  "模型字段": {
    "prefix": "变量",
    "body": [
      "变量 ${1:类型} ${2:字段名}"
    ],
    "description": "声明带类型的变量/模型字段"
  },
  "常量": {
    "prefix": "常量",
    "body": [
      "常量 ${1:类型} ${2:名字} = ${3:值}"
    ],
    "description": "声明常量"
  },
  "模型方法": {
    "prefix": "方法",
    "body": [
      "定义 ${1:模型名} 的 方法 ${2:方法名}(${3:参数})${4: -> ${5:返回类型}}",
      "    $0",
      "结束"
    ],
    "description": "在模型外部定义方法，方法体内可用 自己 访问当前实例"
  },
  "尝试捕获": {
    "prefix": "尝试",
    "body": [
      "尝试",
      "    ${1:可能出错的调用}",
      "捕获 ${2:错误}",
      "    $0",
      "结束"
    ],
    "description": "尝试…捕获 错误处理块"
  },
  "检查调用": {
    "prefix": "检查",
    "body": "检查 ${1:可能返回错误的调用}",
    "description": "检查：自动向上传播错误"
  },
  "导入模块": {
    "prefix": "导入",
    "body": "导入 \"${1:模块路径}\"${2: 作为 ${3:别名}}",
    "description": "导入模块"
  },
  "导出": {
    "prefix": "导出",
    "body": "导出 ${1:变量|常量|函数|模型} ${2:名字}",
    "description": "导出模块成员"
  },
  "打印": {
    "prefix": "打印",
    "body": "打印($0)",
    "description": "打印输出"
  },
  "错误值": {
    "prefix": "错误",
    "body": "错误(\"$0\")",
    "description": "构造错误值"
  },
  "返回": {
    "prefix": "返回",
    "body": "返回 $0",
    "description": "从函数返回"
  }
}
